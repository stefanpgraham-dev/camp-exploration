<div class="ce-board">
  <header class="ce-banner">
    <div>
      <h1><i class="fa-solid fa-compass"></i> Camp & Exploration</h1>
      <p>Journey day <strong>{{day}}</strong> &middot; Players choose their own duties. A natural 1 or 20 is a narrative prompt.</p>
      <p class="ce-progress">Assigned: <strong>{{explorationAssigned}}/{{playerCount}}</strong> exploration &middot; <strong>{{campAssigned}}/{{playerCount}}</strong> campsite &middot; <strong>{{finderCount}}/2</strong> finders</p>
    </div>
    <div class="ce-banner-right">
      <span class="ce-tag">Chaos factor <strong>{{chaos}}</strong></span>
      {{#if gm}}
        <label class="ce-inline">Adjust <input class="ce-chaos-input" data-ce-field="chaos" type="number" min="0" max="9" value="{{chaos}}" /></label>
        <div class="ce-gm-actions">
          <button type="button" data-ce-action="rest"><i class="fa-solid fa-bed"></i> Party rest</button>
          <button type="button" data-ce-action="resetDay" class="ce-reset-day"><i class="fa-solid fa-rotate-left"></i> Reset day</button>
          <button type="button" data-ce-action="advance"><i class="fa-solid fa-forward-step"></i> Next day</button>
        </div>
      {{/if}}
    </div>
  </header>

  <section class="ce-panel ce-pace-panel" aria-label="Travel pace">
    <div class="ce-section-heading">
      <h2><i class="fa-solid fa-person-walking"></i> Travel pace</h2>
      <p>Applies for journey day {{day}}. Distance is relative to your party's normal travel; no fixed miles.</p>
    </div>
    <div class="ce-pace-radio" role="radiogroup" aria-label="Party travel pace">
      {{#each paceOptions}}
        <label class="ce-pace-choice{{#if selected}} ce-pace-selected{{/if}}">
          <input type="radio" name="ce-pace" data-ce-field="pace" value="{{id}}" {{#if selected}}checked{{/if}} {{#unless ../gm}}disabled{{/unless}} />
          <span class="ce-pace-title">{{name}} <strong>{{rate}}</strong></span>
          <small>{{effect}}</small>
        </label>
      {{/each}}
    </div>
    <p class="ce-footnote">Pace penalty cancels proficiency-granted advantage; it never imposes disadvantage on its own. Expertise retains advantage. Slow pace grants advantage on Perception and Survival even if untrained. All skill bonuses remain intact; second-duty disadvantage is separate. Next Day returns to Normal; Reset Day retains the pace. GM sets the pace.</p>
  </section>

  <section class="ce-panel">
    <div class="ce-section-heading">
      <h2><i class="fa-solid fa-route"></i> Exploration roles</h2>
      <p>Each player chooses a primary role. A second duty is optional but imposes disadvantage on both duty checks (cancelled by advantage).</p>
    </div>
    <div class="ce-scroll">
      <table>
        <thead><tr><th>Player / character</th><th>Primary duty</th><th>Roll</th><th>Second duty (optional)</th><th>Roll</th></tr></thead>
        <tbody>
        {{#each players}}
          <tr>
            <td class="ce-player"><strong>{{name}}</strong><small>{{actorName}}</small></td>
            <td><button type="button" class="ce-pick{{#if exploration0.favourable}} ce-pick--favoured{{else}}{{#if exploration0.penalized}} ce-pick--penalized{{/if}}{{/if}}" data-ce-action="pick-role" data-ce-field="exploration0" data-user-id="{{id}}" aria-label="Choose exploration duty for {{name}}" {{#unless editable}}disabled{{/unless}}>
                <span class="ce-pick-title">{{exploration0.name}} <i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span>
                {{#unless exploration0.empty}}<span class="ce-skill-row">{{#each exploration0.skills}}<span class="ce-skill ce-skill--{{state}}" title="{{explanation}}"><span aria-hidden="true">{{prefix}}</span> {{name}}{{#if effect}} <small class="ce-effect">{{effect}}</small>{{/if}}{{#if mandatory}}<b title="Required">*</b>{{/if}}</span>{{/each}}</span>{{/unless}}
              </button></td>
            <td class="ce-roll-cell"><button type="button" class="ce-roll" data-ce-action="roll" data-stage="exploration" data-slot="0" data-user-id="{{id}}" {{#unless canRollExp0}}disabled{{/unless}}><i class="fa-solid fa-dice-d20"></i> Roll</button>{{#if expRolled0}}<span class="ce-result">{{expResult0}}</span>{{/if}}</td>
            <td><button type="button" class="ce-pick{{#if exploration1.favourable}} ce-pick--favoured{{else}}{{#if exploration1.penalized}} ce-pick--penalized{{/if}}{{/if}}" data-ce-action="pick-role" data-ce-field="exploration1" data-user-id="{{id}}" aria-label="Choose secondary exploration duty for {{name}}" {{#unless canPickExploration1}}disabled{{/unless}}>
                <span class="ce-pick-title">{{exploration1.name}} <i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span>
                {{#unless exploration1.empty}}<span class="ce-skill-row">{{#each exploration1.skills}}<span class="ce-skill ce-skill--{{state}}" title="{{explanation}}"><span aria-hidden="true">{{prefix}}</span> {{name}}{{#if effect}} <small class="ce-effect">{{effect}}</small>{{/if}}{{#if mandatory}}<b title="Required">*</b>{{/if}}</span>{{/each}}</span>{{/unless}}
              </button></td>
            <td class="ce-roll-cell"><button type="button" class="ce-roll" data-ce-action="roll" data-stage="exploration" data-slot="1" data-user-id="{{id}}" {{#unless canRollExp1}}disabled{{/unless}}><i class="fa-solid fa-dice-d20"></i> Roll</button>{{#if expRolled1}}<span class="ce-result">{{expResult1}}</span>{{/if}}</td>
          </tr>
        {{/each}}
        </tbody>
      </table>
    </div>
    <details class="ce-reference"><summary>Exploration role reference &amp; guidance</summary><div class="ce-reference-grid">{{#each explorationRoles}}<p><strong>{{name}}</strong><span>{{note}}</span><small>{{guidance}}</small></p>{{/each}}</div></details>
    <p class="ce-footnote">Green ADV means advantage from proficiency or Slow pace; amber EVEN means pace cancelled ordinary proficiency advantage; blue ★ Expertise retains advantage. × indicates untrained, but Slow pace can still grant advantage. A pace penalty never imposes disadvantage by itself. Taking a second duty is a separate disadvantage. * marks a required skill.</p>
  </section>

  <section class="ce-panel">
    <div class="ce-section-heading">
      <h2><i class="fa-solid fa-map-location-dot"></i> Find a campsite</h2>
      <p><strong>Two different players</strong> must volunteer: one Scout and one Guide. Each makes a check against the GM's terrain DC.</p>
    </div>
    <div class="ce-config-line">
      <label>Terrain difficulty
        <select data-ce-field="dc" {{#unless gm}}disabled{{/unless}}>
          {{#each dcOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </label>
      <span class="ce-tag">{{finderCount}} of 2 finders assigned</span>
    </div>
    <div class="ce-scroll">
      <table>
        <thead><tr><th>Player</th><th>Campsite-finding duty</th><th>Check</th></tr></thead>
        <tbody>
        {{#each players}}
          <tr>
            <td class="ce-player"><strong>{{name}}</strong></td>
            <td><button type="button" class="ce-pick{{#if finder.favourable}} ce-pick--favoured{{else}}{{#if finder.penalized}} ce-pick--penalized{{/if}}{{/if}}" data-ce-action="pick-role" data-ce-field="finder" data-user-id="{{id}}" aria-label="Choose campsite-finding duty for {{name}}" {{#unless editable}}disabled{{/unless}}>
                <span class="ce-pick-title">{{finder.name}} <i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span>
                {{#unless finder.empty}}<span class="ce-skill-row">{{#each finder.skills}}<span class="ce-skill ce-skill--{{state}}" title="{{explanation}}"><span aria-hidden="true">{{prefix}}</span> {{name}}{{#if effect}} <small class="ce-effect">{{effect}}</small>{{/if}}{{#if mandatory}}<b title="Required">*</b>{{/if}}</span>{{/each}}</span>{{/unless}}
              </button></td>
            <td class="ce-roll-cell"><button type="button" class="ce-roll" data-ce-action="roll" data-stage="finder" data-user-id="{{id}}" {{#unless canRollFinder}}disabled{{/unless}}><i class="fa-solid fa-dice-d20"></i> Roll</button>{{#if finderRolled}}<span class="ce-result">{{finderTotal}}</span>{{/if}}</td>
          </tr>
        {{/each}}
        </tbody>
      </table>
    </div>
    {{#if siteOutcome}}
      <div class="ce-outcome"><strong>{{siteOutcome.title}}</strong><span>{{siteOutcome.description}}</span></div>
    {{else}}
      <p class="ce-hint">{{#if findersReady}}Both finders assigned. Roll both checks to determine the campsite.{{else}}Assign one Scout and one Guide before rolling.{{/if}}</p>
    {{/if}}
    <details class="ce-reference"><summary>Campsite-finding reference &amp; guidance</summary><div class="ce-reference-grid">{{#each finderRoles}}<p><strong>{{name}}</strong><span>{{note}}</span><small>{{guidance}}</small></p>{{/each}}</div></details>
    <p class="ce-footnote">Two successes: good campsite for a long rest. One success: reasonable campsite, possible long rest (GM decision). Both fail: short rest only. DC 0, 5, 10, 15, 20, 25, 30 are taken from the supplied rules.</p>
  </section>

  <section class="ce-panel">
    <div class="ce-section-heading">
      <h2><i class="fa-solid fa-campground"></i> Campsite roles</h2>
      <p>Everyone chooses a camp duty, including <em>Full Rest</em> if not taking an active duty. As above, a second duty is optional and carries disadvantage.</p>
    </div>
    <div class="ce-scroll">
      <table>
        <thead><tr><th>Player</th><th>Primary duty</th><th>Roll</th><th>Second duty (optional)</th><th>Roll</th></tr></thead>
        <tbody>
        {{#each players}}
          <tr>
            <td class="ce-player"><strong>{{name}}</strong></td>
            <td><button type="button" class="ce-pick{{#if camp0.favourable}} ce-pick--favoured{{else}}{{#if camp0.penalized}} ce-pick--penalized{{/if}}{{/if}}" data-ce-action="pick-role" data-ce-field="camp0" data-user-id="{{id}}" aria-label="Choose camp duty for {{name}}" {{#unless editable}}disabled{{/unless}}>
                <span class="ce-pick-title">{{camp0.name}} <i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span>
                {{#unless camp0.empty}}<span class="ce-skill-row">{{#each camp0.skills}}<span class="ce-skill ce-skill--{{state}}" title="{{explanation}}"><span aria-hidden="true">{{prefix}}</span> {{name}}{{#if effect}} <small class="ce-effect">{{effect}}</small>{{/if}}{{#if mandatory}}<b title="Required">*</b>{{/if}}</span>{{/each}}</span>{{/unless}}
              </button></td>
            <td class="ce-roll-cell"><button type="button" class="ce-roll" data-ce-action="roll" data-stage="camp" data-slot="0" data-user-id="{{id}}" {{#unless canRollCamp0}}disabled{{/unless}}><i class="fa-solid fa-dice-d20"></i> Roll</button>{{#if campRolled0}}<span class="ce-result">{{campResult0}}</span>{{/if}}</td>
            <td><button type="button" class="ce-pick{{#if camp1.favourable}} ce-pick--favoured{{else}}{{#if camp1.penalized}} ce-pick--penalized{{/if}}{{/if}}" data-ce-action="pick-role" data-ce-field="camp1" data-user-id="{{id}}" aria-label="Choose secondary camp duty for {{name}}" {{#unless canPickCamp1}}disabled{{/unless}}>
                <span class="ce-pick-title">{{camp1.name}} <i class="fa-solid fa-chevron-down" aria-hidden="true"></i></span>
                {{#unless camp1.empty}}<span class="ce-skill-row">{{#each camp1.skills}}<span class="ce-skill ce-skill--{{state}}" title="{{explanation}}"><span aria-hidden="true">{{prefix}}</span> {{name}}{{#if effect}} <small class="ce-effect">{{effect}}</small>{{/if}}{{#if mandatory}}<b title="Required">*</b>{{/if}}</span>{{/each}}</span>{{/unless}}
              </button></td>
            <td class="ce-roll-cell"><button type="button" class="ce-roll" data-ce-action="roll" data-stage="camp" data-slot="1" data-user-id="{{id}}" {{#unless canRollCamp1}}disabled{{/unless}}><i class="fa-solid fa-dice-d20"></i> Roll</button>{{#if campRolled1}}<span class="ce-result">{{campResult1}}</span>{{/if}}</td>
          </tr>
        {{/each}}
        </tbody>
      </table>
    </div>
    <details class="ce-reference"><summary>Campsite role reference &amp; guidance</summary><div class="ce-reference-grid">{{#each campRoles}}<p><strong>{{name}}</strong><span>{{note}}</span><small>{{guidance}}</small></p>{{/each}}</div></details>
  </section>

  <div class="ce-lower-grid">
    <section class="ce-panel">
      <div class="ce-section-heading"><h2><i class="fa-solid fa-moon"></i> Campsite watches</h2><p>Four two-hour watches cover an eight-hour camp rest. Each player may take one watch or none; multiple players can share a slot.</p></div>
      <div class="ce-scroll">
        <table>
          <thead><tr><th>Player</th><th>Watch assignment</th><th>Perception</th></tr></thead>
          <tbody>
          {{#each players}}
            <tr><td class="ce-player"><strong>{{name}}</strong></td>
            <td><select data-ce-field="watch" data-user-id="{{id}}" {{#unless editable}}disabled{{/unless}}>{{#each watch}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></td>
            <td class="ce-roll-cell"><span class="ce-skill ce-skill--{{watchSkill.state}}" title="{{watchSkill.explanation}}">{{watchSkill.prefix}} Perception{{#if watchSkill.effect}} <small class="ce-effect">{{watchSkill.effect}}</small>{{/if}}</span> <button type="button" data-ce-action="roll" data-stage="watch" data-user-id="{{id}}" class="ce-roll" {{#unless canRollWatch}}disabled{{/unless}}><i class="fa-solid fa-dice-d20"></i> Roll</button>{{#if watchRolled}}<span class="ce-result">{{watchResult}}</span>{{/if}}</td>
            </tr>
          {{/each}}
          </tbody>
        </table>
      </div>
      <div class="ce-watch-summary">{{#each watchNames}}<p><strong>{{name}}:</strong> {{players}}</p>{{/each}}</div>
    </section>
    <section class="ce-panel">
      <div class="ce-section-heading"><h2><i class="fa-solid fa-box-open"></i> Supply die</h2><p>Check once per journey day. On a 1 or 2, step the die down one size.</p></div>
      <div class="ce-supply-die">{{#if supplyExhausted}}Depleted{{else}}d{{supplyDie}}{{/if}}</div>
      <p class="ce-footnote">Resupply to d8: party supplies &middot; d10: pack animals/mounts &middot; d12: wagons/mounts. Dice step down d12 → d10 → d8 → d6 → d4 → depleted.</p>
      {{#if gm}}
        <div class="ce-supply-actions">
          <button type="button" data-ce-action="supply" {{#unless canRollSupply}}disabled{{/unless}}><i class="fa-solid fa-dice"></i> Check supply</button>
          <label>Resupply <select data-ce-field="resupply"><option value="">Choose…</option>{{#each supplyOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        </div>
        <button type="button" class="ce-muted-button" data-ce-action="reset">Start new expedition</button>
      {{else}}
        <p class="ce-hint">The GM manages supplies and journey days.</p>
      {{/if}}
      {{#if supplyRolled}}<p class="ce-hint">Today's supply check is complete.</p>{{/if}}
    </section>
  </div>
  <footer class="ce-footer">Foundry v14 &middot; D&D 5e &middot; Pace effects on camp checks are homebrew. The GM can apply party rests. Natural 1/20 event effects remain advisory.</footer>
</div>
